# Browser + SSR: FastAPI base URL
NEXT_PUBLIC_PATH_BACKEND=http://localhost:8000

# Server-side proxy (defaults to NEXT_PUBLIC_PATH_BACKEND)
BACKEND_URL=http://localhost:8000

# Must match FastAPI JWT_SECRET (same signing key)
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
