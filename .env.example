# Browser: public API entrypoint (through nginx)
NEXT_PUBLIC_PATH_BACKEND=https://your-domain.com/api

# SSR/server-side in Docker network
BACKEND_URL=http://backend:8000

# Public site URL for SEO metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Must match FastAPI JWT_SECRET (same signing key)
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
